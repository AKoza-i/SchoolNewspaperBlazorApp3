@page "/adminPanel"
@rendermode InteractiveServer
@using SchoolNewspaperBlazorApp.Data

<div class="main-block">
    <h1>Dodaj artykul</h1>
    <form @onsubmit="AddArticle" @onsubmit:preventDefault>
        <input @bind="title" class="form-control"/>
        <textarea @bind="text" class="form-control"/>
        <input @bind="author" class="form-control"/>
        <input type="date" @bind="publishDate" class="form-control"/>
        <button type="submit" class="btn btn-primary">Dodaj</button>
    </form>
    @if(pokazDane)
    {
        <p><strong>@title</strong></p>
        <p><strong>@text</strong></p>
        <p><strong>@author</strong></p>
        <p><strong>@publishDate</strong></p>
    }
</div>

@code {
    private string title = "";
    private string text = "";
    private string author = "";
    private DateTime publishDate = DateTime.Now;
    private bool pokazDane = false;
    private void AddArticle()
    {
        pokazDane = true;
    }
}
